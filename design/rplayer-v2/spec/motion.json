{
  "schema": "rplayer.design.motion/1",
  "tokens": {
    "duration": {
      "instant": 0,
      "press": 90,
      "fast": 140,
      "base": 280,
      "scene": 520
    },
    "easing": {
      "out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
      "in": "cubic-bezier(0.55, 0, 1, 0.45)"
    },
    "rules": [
      "Animate transform and opacity only; never width, height, top, left, or box-shadow.",
      "One-shot motion only. The playing equalizer is the only looping animation and freezes under reduced motion.",
      "No entrance animation longer than 520ms; no stagger above 6 items.",
      "prefers-reduced-motion or the in-app switch sets every duration to 0 and removes transforms; opacity changes may remain at 0ms.",
      "Hover motion must not move the hit target. Press scale is at most 0.99."
    ]
  },
  "patterns": [
    {
      "id": "row.hover",
      "trigger": "pointer enters track row",
      "property": "background-color, border-color",
      "fromTo": "transparent → --surface-hover",
      "duration": "fast",
      "easing": "out",
      "delayMs": 0,
      "reducedMotion": "none"
    },
    {
      "id": "row.select",
      "trigger": "row becomes selected",
      "property": "background-color, inset accent bar",
      "fromTo": "0 → 1",
      "duration": "fast",
      "easing": "out",
      "delayMs": 0,
      "reducedMotion": "instant"
    },
    {
      "id": "row.playing",
      "trigger": "row becomes current track",
      "property": "equalizer opacity, title color",
      "fromTo": "0.4 → 1",
      "duration": "base",
      "easing": "out",
      "delayMs": 0,
      "reducedMotion": "equalizer static"
    },
    {
      "id": "button.press",
      "trigger": "pointer/key down on button",
      "property": "transform, background-color",
      "fromTo": "scale 1 → 0.99",
      "duration": "press",
      "easing": "out",
      "delayMs": 0,
      "reducedMotion": "instant"
    },
    {
      "id": "nav.select",
      "trigger": "sidebar destination selected",
